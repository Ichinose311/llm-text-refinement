# ---------------- src/Tabidachi 配下の設定 ----------------
# src/Tabidachi 配下は基本無視し、Python と Notebook だけ追跡
/src/Tabidachi/**
!/src/Tabidachi/
!/src/Tabidachi/**/
!/src/Tabidachi/**/*.py
!/src/Tabidachi/**/*.ipynb

# ---------------- src/ChatRec 配下の設定 ----------------
# src/ChatRec 配下は基本無視し、Python と Notebook だけ追跡
/src/ChatRec/**
!/src/ChatRec/
!/src/ChatRec/**/
!/src/ChatRec/**/*.py
!/src/ChatRec/**/*.ipynb

# ---------------- Claude / ローカル設定 ----------------
.claude/

